<script>
// Build TOC from chapter headers
document.addEventListener('DOMContentLoaded', function(){
  var chapters = document.querySelectorAll('.chapter');
  var tocList = document.getElementById('toc-list');
  chapters.forEach(function(ch){
    var h2 = ch.querySelector('h2');
    if(!h2) return;
    var li = document.createElement('li');
    li.textContent = h2.textContent;
    li.onclick = function(){
      ch.scrollIntoView({behavior:'smooth', block:'start'});
    };
    tocList.appendChild(li);
  });
  // footer on each chapter (visual only, not required for HTML but nice)
});

// Checklist clicável
document.addEventListener('click', function(e){
  if(e.target && e.target.closest && e.target.closest('#checklist-preprova') ) {
    var li = e.target.closest('li');
    if(li){ li.classList.toggle('done'); }
  }
});

// Alternativas do simulado — seleção única por questão
function selectAlt(el){
  var quest = el.closest('.quest');
  var alts = quest.querySelectorAll('.alt');
  alts.forEach(function(a){ a.classList.remove('sel'); });
  el.classList.add('sel');
}
</script>
